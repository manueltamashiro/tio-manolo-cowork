{
  "name": "tio-manolo-cowork",
  "version": "0.1.0",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:web": "playwright test --project chromium",
    "test:electron": "playwright test --project electron",
    "test:debug": "playwright test --debug",
    "test:unit": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json",
    "electron:start": "electron .",
    "dist": "npm run electron:build && electron-builder --publish=never",
    "dist:win": "npm run electron:build && electron-builder --win --x64 --publish=never",
    "dist:mac": "npm run electron:build && electron-builder --mac --publish=never",
    "dist:linux": "npm run electron:build && electron-builder --linux --publish=never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^11.7.0",
    "crypto-js": "^4.2.0",
    "diff": "^8.0.3",
    "lucide-react": "^0.562.0",
    "next": "^15.1.3",
    "next-intl": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/experimental-ct-react": "^1.57.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/crypto-js": "^4.2.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-builder": "^26.4.0",
    "electron-updater": "^6.7.3",
    "eslint": "^9",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "build": {
    "appId": "com.tiomanolo.cowork",
    "productName": "Tio Manolo Cowork",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/dist/**/*",
      "out/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "version": "0.1.0"
    },
    "publish": {
      "provider": "github",
      "owner": "your-username",
      "repo": "tio-manolo-cowork"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Tio Manolo Cowork"
    }
  }
}
