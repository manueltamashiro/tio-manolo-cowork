# Anthropic API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Database path for chat history (default: ./data/chat.db)
DATABASE_PATH=./data/chat.db

# Optional: Encryption key for API keys (generates automatically if not set)
# ENCRYPTION_KEY=

# Optional: Crash Reporting Configuration
# Enable or disable crash reporting (default: true)
CRASH_REPORTING_ENABLED=true
# URL to submit crash reports to (if not set, reports are stored locally only)
# CRASH_REPORT_URL=https://your-crash-server.com/api/crashes
